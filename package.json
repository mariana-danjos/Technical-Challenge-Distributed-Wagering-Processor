{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "migration:create": "bun src/infrastructure/persistence/migrate.ts create",
    "migration:up": "bun src/infrastructure/persistence/migrate.ts up",
    "migration:down": "bun src/infrastructure/persistence/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/nestjs": "^6.1.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "decimal.js": "^10.5.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/testing": "^11.1.0",
    "@types/bun": "^1.2.0",
    "@types/express": "^5.0.0",
    "eslint": "^9.20.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0"
  }
}
